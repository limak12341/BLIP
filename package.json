{
  "name": "bloxyflip",
  "version": "2.0.0",
  "description": "BFLIP – coinflip game z logowaniem Roblox",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "bot": "node bot.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch --forceExit",
    "test:e2e": "playwright test --config=playwright.config.js"
  },
  "jest": {
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "e2e.spec.js"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "overrides": {
    "form-data": "4.0.5",
    "qs": "6.15.2",
    "tough-cookie": "5.1.2",
    "request-promise-core": "1.1.4",
    "ws": "8.20.1"
  },
  "dependencies": {
    "@seald-io/nedb": "^4.1.2",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-session": "^1.18.0",
    "ioredis": "^5.11.0",
    "noblox.js": "^9.0.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "jest": "^30.4.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  }
}
